# ==============================================================================
# English LMS - Frontend Environment Configuration Template
# NOTE: All VITE_* variables are bundled into client code. NEVER store secrets here!
# For Vercel Production: Add these in Vercel Project Settings -> Environment Variables
# ==============================================================================

# Public HTTPS API Gateway Endpoint (MUST NOT BE localhost in Production)
VITE_API_BASE_URL=https://YOUR_PUBLIC_API_GATEWAY_URL

# Application Name
VITE_APP_NAME=English LMS

