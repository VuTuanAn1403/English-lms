# -----------------------------------------------------------------------------
# ENGLISH LMS ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# Copy file này thành .env và điền các giá trị thực tế trước khi khởi chạy.
# Tuyệt đối KHÔNG commit file .env chứa thông tin bí mật lên Git.
# -----------------------------------------------------------------------------

# Google Gemini AI API Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# JWT Secret Key
JWT_SECRET=YOUR_JWT_SECRET_HERE

# PostgreSQL Database Configuration
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# Network & Service URLs
CONFIG_SERVER_URL=http://config-server:8888
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://discovery-server:8761/eureka/
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend API Gateway Base URL
VITE_API_BASE_URL=https://YOUR_PUBLIC_API_URL
