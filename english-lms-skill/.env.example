# -----------------------------------------------------------------------------
# ENGLISH LMS ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# Copy file này thành .env và điền các giá trị thực tế trước khi khởi chạy.
# Tuyệt đối KHÔNG commit file .env chứa thông tin bí mật lên Git.
# -----------------------------------------------------------------------------

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# JWT Secret Key (Tối thiểu 32 ký tự / 256 bits)
JWT_SECRET=english-lms-jwt-secret-key-must-be-at-least-256-bits-long-for-security

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Network & Service URLs
CONFIG_SERVER_URL=http://config-server:8888
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://discovery-server:8761/eureka/
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend API Gateway Base URL
VITE_API_BASE_URL=http://localhost:8080
